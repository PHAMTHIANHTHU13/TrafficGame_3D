  violations:
  - violationName: "V\u01B0\u1EE3t \u0111\xE8n \u0111\u1ECF"
    NotifyName: "Ph\u1EA1t ti\u1EC1n t\u1EEB 4.000.000 - 6.000.000 \u0111\u1ED3ng"
    fineMessage: "V\u01B0\u1EE3t \u0111\xE8n \u0111\u1ECF c\xF3 th\u1EC3 b\u1ECB
      ph\u1EA1t t\u1EEB 4\u20136 tri\u1EC7u \u0111\u1ED3ng v\xE0 b\u1ECB tr\u1EEB
      \u0111i\u1EC3m GPLX. N\u1EBFu g\xE2y tai n\u1EA1n giao th\xF4ng, m\u1EE9c ph\u1EA1t
      c\xF3 th\u1EC3 t\u0103ng l\xEAn 10\u201314 tri\u1EC7u \u0111\u1ED3ng."
    dangerMessage: "H\xE0nh vi n\xE0y g\xE2y nguy hi\u1EC3m cho ng\u01B0\u1EDDi tham
      gia giao th\xF4ng."
    adviceMessage: "C\u1EA7n ch\xFA \xFD t\xEDn hi\u1EC7u giao th\xF4ng tr\u01B0\u1EDBc
      khi qua giao l\u1ED9"
  - violationName: "\u0110i v\xE0o v\u1EC9a h\xE8"
    NotifyName: "Ph\u1EA1t t\u1EEB 4.000.000 \u2013 6.000.000 tri\u1EC7u \u0111\u1ED3ng"
    fineMessage: "Ph\u1EA1t t\u1EEB 4.000.000 \u2013 6.000.000 tri\u1EC7u \u0111\u1ED3ng
      \u0111\u1ED1i v\u1EDBi h\xE0nh vi ng\u01B0\u1EDDi \u0111i\u1EC1u khi\u1EC3n
      ph\u01B0\u01A1ng ti\u1EC7n \u0111i tr\xEAn v\u1EC9a h\xE8 v\xE0 tr\u1EEB \u0111i\u1EC3m
      gi\u1EA5y ph\xE9p l\xE1i xe"
    dangerMessage: "H\xE0nh vi n\xE0y g\xE2y nguy hi\u1EC3m cho ng\u01B0\u1EDDi \u0111i
      b\u1ED9"
    adviceMessage: "H\xE3y \u0111i \u0111\xFAng ph\u1EA7n \u0111\u01B0\u1EDDng \u0111\u1EC3
      \u0111\u1EA3m b\u1EA3o an to\xE0n cho b\u1EA3n th\xE2n v\xE0 m\u1ECDi ng\u01B0\u1EDDi."
  - violationName: "Va ch\u1EA1m v\u1EDBi ph\u01B0\u01A1ng ti\u1EC7n kh\xE1c"
    NotifyName: "Ph\u1EA1t t\u1EEB 10.000.000 \u2013 14.000.000 tri\u1EC7u \u0111\u1ED3ng"
    fineMessage: "Ng\u01B0\u1EDDi g\xE2y tai n\u1EA1n giao th\xF4ng c\xF3 th\u1EC3
      b\u1ECB ph\u1EA1t \u0111\u1EBFn 14.000.000 tri\u1EC7u \u0111\u1ED3ng, b\u1ECB
      tr\u1EEB \u0111i\u1EC3m GPLX ho\u1EB7c t\u01B0\u1EDBc quy\u1EC1n s\u1EED d\u1EE5ng
      GPLX t\xF9y m\u1EE9c \u0111\u1ED9 vi ph\u1EA1m."
    dangerMessage: "Va ch\u1EA1m giao th\xF4ng c\xF3 th\u1EC3 g\xE2y ch\u1EA5n th\u01B0\u01A1ng
      nghi\xEAm tr\u1ECDng cho b\u1EA1n v\xE0 ng\u01B0\u1EDDi tham gia giao th\xF4ng
      kh\xE1c.\n"
    adviceMessage: "H\xE3y gi\u1EEF kho\u1EA3ng c\xE1ch an to\xE0n v\xE0 ch\xFA \xFD
      quan s\xE1t khi \u0111i\u1EC1u khi\u1EC3n ph\u01B0\u01A1ng ti\u1EC7n."
